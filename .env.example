# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored; this example file is safe to commit.

# Google Maps Android API key.
# Create & restrict it in Google Cloud Console → APIs & Services → Credentials:
#   - Application restriction: Android app  (package ca.gstcyr.stlgps + release SHA-1)
#   - API restriction: Maps SDK for Android
GOOGLE_MAPS_API_KEY=
