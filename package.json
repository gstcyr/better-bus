{
  "name": "mybusstop",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "expo": "~57.0.22",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.18",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.22",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:apk": ". ./android-env.sh && ./android/gradlew -p android assembleRelease && echo 'APK → android/app/build/outputs/apk/release/app-release.apk'",
    "install:apk": ". ./android-env.sh && adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "apk": "npm run build:apk && npm run install:apk",
    "clean:android": ". ./android-env.sh && ./android/gradlew -p android clean",
    "logcat": ". ./android-env.sh && adb logcat ReactNativeJS:V *:S",
    "alarms": ". ./android-env.sh && adb shell dumpsys alarm | grep -A6 ca.gstcyr.stlgps"
  },
  "private": true
}
